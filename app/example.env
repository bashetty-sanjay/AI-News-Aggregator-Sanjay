# Google Gemini API (100% FREE - Recommended)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=

# Email Configuration (Gmail SMTP)
MY_EMAIL=your_email@gmail.com
RECIPIENT_EMAIL=your_email@gmail.com
APP_PASSWORD=

# User Profile Configuration
USER_NAME=YourName

# Webshare Proxy (Optional, for YouTube transcript fetching)
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# Environment Configuration
ENVIRONMENT=LOCAL

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news_aggregator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set to true to use SQLite locally without PostgreSQL
USE_SQLITE=false
